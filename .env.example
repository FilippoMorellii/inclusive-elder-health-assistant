# =====================================================================
# Elder Health Assistant - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# Never commit your real '.env' file to version control!
# =====================================================================

# Telegram Bot Token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Google Gemini API Key from Google AI Studio (for the AI Smart Leaflet feature)
GEMINI_API_KEY="your_gemini_api_key_here"

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

# Minutes before notifying the caregiver if medication intake is not confirmed (default: 15)
CAREGIVER_TIMEOUT_MINUTES=15
